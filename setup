#!/usr/bin/env bash
# aight-codex setup — installs deps and registers an `aight-codex` shell command.
set -euo pipefail

# Auto-detect INSTALL_DIR from the script's own location (works whether run
# from a git clone or from the suggested ~/.codex/channels/aight install path).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_DIR="${INSTALL_DIR:-$SCRIPT_DIR}"
SHELL_RC="${SHELL_RC:-}"

# Detect rc file from $SHELL if not overridden.
if [ -z "$SHELL_RC" ]; then
  case "${SHELL:-}" in
    */zsh) SHELL_RC="$HOME/.zshrc" ;;
    */bash) SHELL_RC="$HOME/.bashrc" ;;
    *) SHELL_RC="$HOME/.profile" ;;
  esac
fi

echo "→ Installing dependencies in $INSTALL_DIR …"
cd "$INSTALL_DIR"
bun install --no-summary

# Force-replace any existing aight-codex block so a stale function from a
# previous setup version gets refreshed. The block is delimited by markers
# we own — we never touch lines outside them.
START_MARKER="# aight-codex — BEGIN (do not edit, regenerated by setup)"
END_MARKER="# aight-codex — END"
BLOCK=$(cat <<EOF
$START_MARKER
aight-codex() {
  # Capture the user's invocation cwd before cd'ing into the plugin dir
  # (the cd is needed so bun resolves the plugin's node_modules; the env
  # var carries the original cwd through to codex app-server).
  local _aight_cwd="\$PWD"
  (cd "$INSTALL_DIR" && AIGHT_CODEX_CWD="\$_aight_cwd" bun src/index.ts "\$@")
}
$END_MARKER
EOF
)

if [ -f "$SHELL_RC" ] && grep -qF "$START_MARKER" "$SHELL_RC"; then
  # Replace existing block in-place. BSD awk (macOS) chokes on multi-line
  # -v strings, so write the new block to a temp file and pull it in via
  # getline — works on both BSD and GNU awk.
  TMP=$(mktemp)
  BLOCK_FILE=$(mktemp)
  printf '%s\n' "$BLOCK" > "$BLOCK_FILE"
  awk -v start="$START_MARKER" -v end="$END_MARKER" -v blockfile="$BLOCK_FILE" '
    $0 == start { in_block = 1; while ((getline line < blockfile) > 0) print line; close(blockfile); next }
    in_block && $0 == end { in_block = 0; next }
    !in_block { print }
  ' "$SHELL_RC" > "$TMP"
  mv "$TMP" "$SHELL_RC"
  rm -f "$BLOCK_FILE"
  echo "✓ Refreshed \`aight-codex\` function in $SHELL_RC"
else
  printf "\n%s\n" "$BLOCK" >> "$SHELL_RC"
  echo "✓ Added \`aight-codex\` shell function to $SHELL_RC"
fi

# Also clean up the OLD marker style from earlier setup versions so they
# don't leave a stale function definition lying around.
OLD_MARKER="# aight-codex — Codex CLI mobile channel"
if grep -qF "$OLD_MARKER" "$SHELL_RC" 2>/dev/null; then
  TMP=$(mktemp)
  # Delete the old marker line + the 3 lines below it (the old function body).
  awk -v marker="$OLD_MARKER" '
    $0 == marker { skip = 4 }
    skip > 0 { skip--; next }
    { print }
  ' "$SHELL_RC" > "$TMP"
  mv "$TMP" "$SHELL_RC"
  echo "✓ Removed stale old-style aight-codex block"
fi

echo
echo "Done. Open a new terminal (or run \`source $SHELL_RC\`) and run:"
echo "  aight-codex"
echo
echo "A 6-digit pairing code will appear. Enter it in the Aight app."
